{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "esModuleInterop": false,
    "noEmit": true,
    "strict": true,
    "types": ["vite/client"]
  }
}
