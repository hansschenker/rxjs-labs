  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["config.ts", "../**/*.ts", "../**/*.md"],
